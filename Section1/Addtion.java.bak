

import java.util.*;
class Addtion 
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		System.out.println("Enter The first Number");
		int a=sc.nextint();
		System.out.println("Enter The second Number");
		int b=sc.nextint();
		
		int c=a+b;
		System.out.println("Sum of number:",+c);
		
	}
}
